# Public analytics and conversion tracking
# Required for Google Tag Manager container injection.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Ads destination ID used by gtag.js.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-969671559

# Google Ads Conversion Action IDs (pushed on dataLayer as conversion_action_id).
# GTM Custom Event triggers should listen for phone_call_click / map_directions_click
# (and cta_click / whatsapp_click) and fire the matching Ads Conversion tags.
NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_ACTION_ID=6560221892
NEXT_PUBLIC_GOOGLE_ADS_DIRECTIONS_CONVERSION_ACTION_ID=6560221601
# Optional: WhatsApp action ID when you create that conversion in Google Ads.
# NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_ACTION_ID=

# Optional website-tag conversion labels for direct gtag send_to (AW-xxx/LABEL).
# Prefer configuring labels in GTM tags; set these only if you want dual gtag firing.
# NEXT_PUBLIC_GOOGLE_ADS_CALL_CONVERSION_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_DIRECTIONS_CONVERSION_LABEL=
# NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=

# Public Web3Forms access key for the contact/quote forms.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend API Key for email functionality
# Get your API key from https://resend.com/api-keys
# Emails will be sent from your verified domain to admin@albertonbatterymart.co.za
RESEND_API_KEY=re_your_api_key_here

# Admin credentials (for price manager at /admin)
# Password-only login — set ADMIN_PASSWORD on Vercel for production.
ADMIN_PASSWORD=admin@abm

# Vercel Blob — for price saves to persist on production (serverless).
# Option A (easiest): Vercel dashboard → Storage → Blob → connect to this project.
#   Vercel auto-adds BLOB_READ_WRITE_TOKEN, BLOB_STORE_ID, and VERCEL_OIDC_TOKEN.
# Option B: paste credentials manually in Vercel project env vars.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
# Optional: set to "public" only if your Blob store is public (default: private)
BLOB_STORE_ACCESS=private
