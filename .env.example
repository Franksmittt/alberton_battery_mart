# Public analytics and conversion tracking
# Required for Google Tag Manager container injection.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Google Ads destination ID used by gtag.js.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-969671559

# Public Web3Forms access key for the contact/quote forms.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Resend API Key for email functionality
# Get your API key from https://resend.com/api-keys
# Emails will be sent from your verified domain to admin@albertonbatterymart.co.za
RESEND_API_KEY=re_your_api_key_here

# Admin credentials (for price manager at /admin)
# Password-only login — set ADMIN_PASSWORD on Vercel for production.
ADMIN_PASSWORD=admin@abm

# Vercel Blob — required for price saves to persist on production (serverless).
# Create a Blob store in the Vercel dashboard and add the read/write token here.
BLOB_READ_WRITE_TOKEN=
